{
  "name": "@monitour/agent",
  "version": "0.2.6",
  "description": "Monitour remote management agent",
  "author": "Monitour",
  "private": true,
  "type": "module",
  "main": "./out/main/electron.js",
  "scripts": {
    "dev": "tsc && electron .",
    "dev:cli": "tsx src/main/index.ts",
    "clean": "node -e \"const fs=require('fs');for(const d of ['out','dist'])fs.rmSync(d,{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "tsc",
    "start": "electron .",
    "dist": "electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monitour/shared": "*",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "axios": "^1.8.0",
    "bcryptjs": "^3.0.2",
    "jpeg-js": "^0.4.4",
    "koffi": "^3.3.7",
    "node-forge": "^1.3.1",
    "node-pty": "^1.1.0",
    "node-screenshots": "^0.2.8",
    "screenshot-desktop": "^1.15.0",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.11",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
