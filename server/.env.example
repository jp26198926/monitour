# Monitour Server Configuration
# Copy to .env and fill in values

# Server
PORT=4430
HOST=0.0.0.0
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/monitour

# JWT — MUST be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=24h
DEVICE_JWT_EXPIRES_IN=365d

# Data directory (certs, keys)
DATA_DIR=./data

# CORS — dashboard origin(s), comma-separated
CORS_ORIGIN=https://monitour.yourdomain.com

# Logging
LOG_LEVEL=info
